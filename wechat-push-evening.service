[Unit]
Description=WeChat daily push (evening slot, 18:00 Asia/Shanghai)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/hatch/workspace/wechat-bridge
ExecStart=/usr/bin/python3 /home/hatch/workspace/wechat-bridge/daily_push.py evening
